<Window x:Class="MyFirstWPFApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyFirstWPFApp"
        mc:Ignorable="d"
        Title="MyTestWindow" Height="450" Width="800" Loaded="Window_Loaded_1">
    <Canvas>
        <Button x:Name="btnLoad" Content="Load" Canvas.Left="384" 
                Canvas.Top="103" Height="39" Width="117" FontSize="18" 
                Background="#FFCEB9B9" Click="btnLoad_Click" />
        <Button x:Name="btnSave" Content="Save" FontSize="18" Foreground="White" 
                Background="DarkRed" 
                Canvas.Left="522" Canvas.Top="103" Height="39" Width="96" 
                HorizontalAlignment="Left" VerticalAlignment="Center" Click="btnSave_Click"/>
        <TextBox x:Name="tbContent" Canvas.Left="92" TextWrapping="Wrap" 
                 Canvas.Top="142" Width="230" Height="217"/>
        <TextBox x:Name="tbFilePath" Canvas.Left="92" TextWrapping="Wrap" 
                 Text="C:\Temp\text.txt" Canvas.Top="103" Width="230" Height="34" TextChanged="tbFilePath_TextChanged"/>
        <ComboBox x:Name="cbUsers" Canvas.Left="418" Canvas.Top="201" Width="138" 
                  HorizontalAlignment="Left" VerticalAlignment="Center" 
                  SelectionChanged="cbUsers_SelectionChanged"/>

    </Canvas>
</Window>
